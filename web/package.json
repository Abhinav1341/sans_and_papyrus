{
  "name": "party-galaxy",
  "version": "0.1.0",
  "private": true,
  "description": "Party Galaxy: a mobile-first anime story game (Next.js). Cinematic story player, distinct character voices, task gates.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/validate-story.ts",
    "voices:export": "tsx tools/voices/export-lines.ts",
    "voices:warm": "tsx --env-file=.env.local tools/warm-voices.mts",
    "test:backend": "tsx tests/backend-flow.mts",
    "test:scoring": "tsx --env-file-if-exists=.env.local tests/scoring-audit.mts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@google/genai": "^2.30.0",
    "google-auth-library": "^10.9.1",
    "gsap": "^3.15.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
